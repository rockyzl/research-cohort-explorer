# Copy to .env (gitignored). Pick one LLM provider; without either, the template fallback is used.

# Option 1: OpenAI API. The key is read from the environment by the OpenAI SDK and never stored by this repo.
# OPENAI_API_KEY=<your-key>
# COHORT_OPENAI_MODEL=gpt-4.1-2025-04-14
# COHORT_LLM_PROVIDER=openai

# Option 2: an Azure OpenAI deployment. No API key: auth uses a short-lived token from the local Azure CLI login.
# COHORT_AZURE_ENDPOINT=https://<your-resource>.openai.azure.com/
# COHORT_AZURE_SUBSCRIPTION=<subscription-id>
# COHORT_AZURE_DEPLOYMENT=gpt-4.1
# COHORT_LLM_PROVIDER=azure
